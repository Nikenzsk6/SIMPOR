# =============================================
#  GITIGNORE - SIMPOR
#  File ini di folder paling atas (sejajar index.php)
# =============================================

# --- Dependency Composer -------------------------
# Di-restore otomatis dengan: composer install
# (composer.json + composer.lock ikut di-commit)
/vendor/

# --- File unggahan pengguna ----------------------
# Berisi PDF sertifikat & hasil ujian.
# Ini DATA, bukan kode. Jangan masuk riwayat git.
/uploads/
/assets/upload/

# --- Kredensial & konfigurasi lokal -------------
# Salinan aman ada di: includes/config.example.php
/includes/config.php
/.env

# --- Berkas sistem operasi & editor --------------
Thumbs.db
ehthumbs.db
Desktop.ini

.DS_Store
.idea/
.vscode/
*.swp

# --- Log & cache ---------------------------------
*.log
npm-debug.log*
.php-cs-fixer.cache

# --- Berkas sementara saat upload ----------------
*.tmp
*.bak
~$*

# --- Dump / cadangan database --------------------
# JANGAN pernah commit data asli. Dump database berisi nama,
# kontak, alamat, dan hash password semua user.
*.sql
*.sql.gz
*.dump
*.bak.sql

# Pengecualian: HANYA file demo/skema ini yang boleh di-commit.
# File .sql lain (termasuk dump data asli) tetap diabaikan.
!/docs/seed-contoh.sql
!/docs/CARA-HAPUS-DATA-CONTOH.sql
!/docs/skema-database.sql

# --- Folder cadangan lokal -----------------------
/backup/
/database/
/dump/
_dump/

# --- Dokumen internal (RTM tugas, dsb.) ----------
# Dokumen internal tidak perlu ikut ke repositori publik.
/RTM*.xlsx
/_rtm_dump*.txt
